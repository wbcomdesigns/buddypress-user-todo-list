    { "action": "bptodo_get_todo_card_html", "handler": "public/class-bptodo-public.php::bptodo_get_todo_card_html", "nonce": "bptodo-todo-nonce", "capability": "logged-in member", "purpose": "Return rendered todo-card HTML (used to refresh list after AJAX ops).", "registered_at": "includes/class-bptodo.php:283" },
