    { "action": "bptodo_network_deactivate", "handler": "bp-user-todo-list.php::bptodo_handle_network_deactivation", "nonce": "bptodo_network_nonce", "capability": "manage_network_plugins (bp-user-todo-list.php:594)", "purpose": "Network-wide deactivation (only when BPTODO_ENABLE_ADVANCED_MULTISITE is defined true; off by default).", "registered_at": "bp-user-todo-list.php:586" }
  ],
