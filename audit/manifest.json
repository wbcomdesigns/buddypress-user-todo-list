  "admin_ui_wrapper": {
    "classification": "NEW",
    "evidence": "The legacy admin/wbcom/ wrapper directory (class Wbcom_Admin_Settings) has been DELETED - it no longer exists on disk. The current admin surface is the card-panel pattern: includes/admin/class-bptodo-admin-panel.php (class Bptodo_Admin_Panel) registers the shared 'wbcomplugins' hub menu (:113, only when no sibling registered it first) plus one 'Todo Lists' submenu (:124), and renders through includes/admin/views/shell.php with sidebar tabs from Bptodo_Admin_Panel::get_tabs() (:42-85). takeover_hub_landing() at admin_menu@999 (:96) reclaims the hub landing from any legacy-wrapper sibling. The legacy Bptodo_Admin class is retained for non-UI logic only (register_setting, sanitizers, the custom General-tab save handler, frontend asset enqueue).",
    "wrapper_file": "includes/admin/views/shell.php",
    "wrapper_assets": ["assets/css/admin.css", "assets/js/admin.js"],
    "wrapper_templates": [
      "includes/admin/views/shell.php",
      "includes/admin/views/hub.php",
      "includes/admin/views/overview.php",
      "includes/admin/views/settings-general.php",
      "includes/admin/views/settings-group.php",
      "includes/admin/views/settings-retention.php",
      "includes/admin/views/settings-shortcodes.php",
      "includes/admin/views/discover.php"
    ]
  },
  "rest": {
    "namespace": "bptodo/v1",
    "endpoints": [
      { "route": "/todos", "methods": ["GET"], "callback": "Bptodo_REST_Controller::get_todos", "permission_callback": "auth_logged_in", "registered_at": "includes/rest/class-bptodo-rest-controller.php:33", "args": "collection_args()", "purpose": "List todos in the requested scope (personal or filtered)." },
      { "route": "/todos", "methods": ["POST"], "callback": "Bptodo_REST_Controller::create_todo", "permission_callback": "auth_can_create", "registered_at": "includes/rest/class-bptodo-rest-controller.php:33", "args": "writable_args(true)", "purpose": "Create a personal todo. Enforces req_duedate (400 bptodo_due_required)." },
      { "route": "/todos/(?P<id>\\d+)", "methods": ["GET"], "callback": "Bptodo_REST_Controller::get_todo", "permission_callback": "auth_can_view", "registered_at": "includes/rest/class-bptodo-rest-controller.php:52", "args": "id (path)", "purpose": "Fetch a single todo the caller may view." },
      { "route": "/todos/(?P<id>\\d+)", "methods": ["PUT", "PATCH"], "callback": "Bptodo_REST_Controller::update_todo", "permission_callback": "auth_can_edit", "registered_at": "includes/rest/class-bptodo-rest-controller.php:52", "args": "writable_args(false)", "purpose": "Update a todo (inline edit: title, description, due_date, priority, category)." },
      { "route": "/todos/(?P<id>\\d+)", "methods": ["DELETE"], "callback": "Bptodo_REST_Controller::delete_todo", "permission_callback": "auth_can_delete", "registered_at": "includes/rest/class-bptodo-rest-controller.php:52", "args": "id (path)", "purpose": "Delete a todo." },
      { "route": "/todos/(?P<id>\\d+)/complete", "methods": ["POST"], "callback": "Bptodo_REST_Controller::complete_todo", "permission_callback": "auth_can_complete", "registered_at": "includes/rest/class-bptodo-rest-controller.php:75", "args": "id (path)", "purpose": "Mark a todo complete." },
      { "route": "/todos/(?P<id>\\d+)/complete", "methods": ["DELETE"], "callback": "Bptodo_REST_Controller::uncomplete_todo", "permission_callback": "auth_can_complete", "registered_at": "includes/rest/class-bptodo-rest-controller.php:75", "args": "id (path)", "purpose": "Revert a completed todo to active." },
      { "route": "/todos/stats", "methods": ["GET"], "callback": "Bptodo_REST_Controller::get_stats", "permission_callback": "auth_logged_in", "registered_at": "includes/rest/class-bptodo-rest-controller.php:92", "args": "user_id, group_id", "purpose": "Aggregate counts for the list header." },
      { "route": "/categories", "methods": ["GET"], "callback": "Bptodo_REST_Controller::get_categories", "permission_callback": "auth_logged_in", "registered_at": "includes/rest/class-bptodo-rest-controller.php:106", "args": "(none)", "purpose": "List todo_category terms for the filter + add-form selects." },
      { "route": "/categories", "methods": ["POST"], "callback": "Bptodo_REST_Controller::create_category", "permission_callback": "auth_can_add_category", "registered_at": "includes/rest/class-bptodo-rest-controller.php:106", "args": "name (required)", "purpose": "Create a category from the frontend (gated by allow_user_add_category)." },
      { "route": "/groups/(?P<group_id>\\d+)/todos", "methods": ["GET"], "callback": "Bptodo_REST_Controller::get_group_todos", "permission_callback": "auth_group_member", "registered_at": "includes/rest/class-bptodo-rest-controller.php:129", "args": "collection_args()", "purpose": "List a BuddyPress group's todos (members only)." },
      { "route": "/groups/(?P<group_id>\\d+)/todos", "methods": ["POST"], "callback": "Bptodo_REST_Controller::create_group_todo", "permission_callback": "auth_can_create_group_todo", "registered_at": "includes/rest/class-bptodo-rest-controller.php:129", "args": "writable_args(true) + assignees[] (sanitize_assignees)", "purpose": "Create a group todo and fan it out to assignees. Requires a group manager." }
